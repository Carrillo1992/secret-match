# Copy to .env and adjust. Placeholder values only: never put real secrets here.

# ---------- docker compose (local stack) ----------
POSTGRES_DB=secretmatch
POSTGRES_USER=secretmatch
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080
SPA_PORT=4200

# ---------- API (read directly by Spring Boot when run outside compose) ----------
