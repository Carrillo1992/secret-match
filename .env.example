# DATABASE_URL=jdbc:postgresql://localhost:5432/secretmatch
# DATABASE_USERNAME=secretmatch
# DATABASE_PASSWORD=change-me
# CORS_ALLOWED_ORIGIN=http://localhost:4200

# ---------- SPA container ----------
# API_BASE_URL=http://localhost:8080
