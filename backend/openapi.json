        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DrawResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Run the Group's Draw",
        "tags" : [ "draw" ]
      }
    },
