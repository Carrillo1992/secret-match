# Copy to .env and adjust. Placeholder values only: never put real secrets here.

# ---------- docker compose (local stack) ----------
POSTGRES_DB=secretmatch
POSTGRES_USER=secretmatch
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080
SPA_PORT=4200
MAILPIT_PORT=8025
MAIL_FROM_ADDRESS=no-reply@secretmatch.local
# Signs access tokens: Base64 of at least 32 random bytes, e.g. `openssl rand -base64 32`.
JWT_SIGNING_KEY=bG9jYWwtb25seS1wbGFjZWhvbGRlci1jaGFuZ2UtbWUtMDEyMzQ1Ng==
# "Continuar con Google": the OAuth client id from Google Cloud (ends in .apps.googleusercontent.com).
# Optional: left empty, Google sign-in is off. The same value goes to the API and the SPA.
GOOGLE_CLIENT_ID=

# ---------- API (read directly by Spring Boot when run outside compose) ----------
# SPRING_PROFILES_ACTIVE=local
# DATABASE_URL=jdbc:postgresql://localhost:5432/secretmatch
# DATABASE_USERNAME=secretmatch
# DATABASE_PASSWORD=change-me
# CORS_ALLOWED_ORIGIN=http://localhost:4200
# MAIL_FROM_ADDRESS=no-reply@secretmatch.local
# APP_BASE_URL=http://localhost:4200
# JWT_SIGNING_KEY=bG9jYWwtb25seS1wbGFjZWhvbGRlci1jaGFuZ2UtbWUtMDEyMzQ1Ng==
# GOOGLE_CLIENT_ID=
# local profile only: the mail catcher started by docker compose
# MAILPIT_URL=http://localhost:8025
# prod profile only: Resend API key (set it in the host's secret settings, never here)
# RESEND_API_KEY=

# ---------- SPA container ----------
# API_BASE_URL=http://localhost:8080
# GOOGLE_CLIENT_ID=
