# Copy to .env and adjust. Placeholder values only: never put real secrets here.

# ---------- docker compose (local stack) ----------
POSTGRES_DB=secretmatch
POSTGRES_USER=secretmatch
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080
SPA_PORT=4200
MAILPIT_PORT=8025
MAIL_FROM_ADDRESS=no-reply@secretmatch.local
# Signs access tokens: Base64 of at least 32 random bytes, e.g. `openssl rand -base64 32`.
# The value below is a public local placeholder: the prod profile refuses to start with it.
JWT_SIGNING_KEY=bG9jYWwtb25seS1wbGFjZWhvbGRlci1jaGFuZ2UtbWUtMDEyMzQ1Ng==
# "Continuar con Google": the OAuth client id from Google Cloud (ends in .apps.googleusercontent.com).
# Optional: left empty, Google sign-in is off. The same value goes to the API and the SPA.
GOOGLE_CLIENT_ID=
# Notifications on devices (Web Push, #119): a VAPID key pair, both base64url, e.g. from
# `npx web-push generate-vapid-keys`. Optional outside prod: left empty, pushing is off and a push is only
# logged. Required in prod (Heroku config vars). VAPID_SUBJECT is a mailto: or https: contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:no-reply@secret-match.app

# ---------- API (read directly by Spring Boot when run outside compose) ----------
# SPRING_PROFILES_ACTIVE=local
# Port to listen on; 8080 when unset. Heroku sets it on its own.
# PORT=8080
# DATABASE_URL=jdbc:postgresql://localhost:5432/secretmatch
# DATABASE_USERNAME=secretmatch
# DATABASE_PASSWORD=change-me
# prod profile only: DATABASE_URL may instead be the form Heroku Postgres sets (and rotates) itself,
# postgres://user:password@host:5432/dbname; the API then connects with SSL required and needs
# neither DATABASE_USERNAME nor DATABASE_PASSWORD.
# JVM memory flags are set in backend/Dockerfile; a JAVA_TOOL_OPTIONS variable replaces them.
# CORS_ALLOWED_ORIGIN=http://localhost:4200
# MAIL_FROM_ADDRESS=no-reply@secretmatch.local
# APP_BASE_URL=http://localhost:4200
# JWT_SIGNING_KEY=bG9jYWwtb25seS1wbGFjZWhvbGRlci1jaGFuZ2UtbWUtMDEyMzQ1Ng==
# GOOGLE_CLIENT_ID=
# local profile only: the mail catcher started by docker compose
# MAILPIT_URL=http://localhost:8025
# prod profile only: Resend API key (set it in the host's secret settings, never here)
# RESEND_API_KEY=

# ---------- SPA container ----------
# API_BASE_URL=http://localhost:8080
# GOOGLE_CLIENT_ID=
