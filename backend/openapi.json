{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "tags" : [ {
    "description" : "Monitor and interact",
    "externalDocs" : {
      "description" : "Spring Boot Actuator Web API Documentation",
      "url" : "https://docs.spring.io/spring-boot/docs/current/actuator-api/html/"
    },
    "name" : "Actuator"
  } ],
  "paths" : {
    "/actuator/health" : {
      "get" : {
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Health"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Actuator web endpoint 'health'",
        "tags" : [ "Actuator" ]
      }
    },
    "/api/v1/email-verifications" : {
      "post" : {
        "operationId" : "verifyEmail",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LinkTokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Verify an email with the token from its verification link, creating the User",
        "tags" : [ "sign-up" ]
      }
    },
    "/api/v1/groups" : {
      "get" : {
        "description" : "Soonest Exchange Date first.",
        "operationId" : "myGroups",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/GroupSummaryResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The Groups the signed-in User is a Member of",
        "tags" : [ "groups" ]
      },
      "post" : {
        "description" : "The signed-in User becomes its Admin and first Member.",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateGroupRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Create a Group",
        "tags" : [ "groups" ]
      }
    },
    "/api/v1/groups/{groupId}" : {
      "get" : {
        "operationId" : "group",
        "parameters" : [ {
          "in" : "path",
          "name" : "groupId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "A Group the signed-in User is a Member of",
        "tags" : [ "groups" ]
      }
    },
    "/api/v1/groups/{groupId}/invite-link" : {
      "post" : {
        "description" : "Only the Admin can. The previous Invite Link stops working.",
        "operationId" : "regenerateInviteLink",
        "parameters" : [ {
          "in" : "path",
          "name" : "groupId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GroupResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Regenerate the Group's Invite Link",
        "tags" : [ "groups" ]
      }
    },
    "/api/v1/groups/{groupId}/members/{memberId}" : {
      "delete" : {
        "description" : "A Member leaves when memberId is their own id; only the Admin can remove someone else, and the Admin cannot leave. The removed Member is emailed.",
        "operationId" : "removeMember",
        "parameters" : [ {
          "in" : "path",
          "name" : "groupId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "in" : "path",
          "name" : "memberId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Leave the Group, or remove a Member from it",
        "tags" : [ "groups" ]
      }
    },
    "/api/v1/memberships" : {
      "post" : {
        "description" : "A User who is a Member already just gets the Group back. A code that matches no Group's current Invite Link is a 404 that says nothing about any Group.",
        "operationId" : "join",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/JoinGroupRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MembershipResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Join a Group through its Invite Link",
        "tags" : [ "invite-links" ]
      }
    },
    "/api/v1/sessions" : {
      "post" : {
        "description" : "Sets the refresh token cookie. A wrong email or password gets the same answer.",
        "operationId" : "signIn",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignInRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Sign in with email and password",
        "tags" : [ "sessions" ]
      }
    },
    "/api/v1/sessions/current" : {
      "delete" : {
        "description" : "Ends the session of the refresh token cookie and clears it.",
        "operationId" : "signOut",
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Sign out",
        "tags" : [ "sessions" ]
      }
    },
    "/api/v1/sessions/refresh" : {
      "post" : {
        "description" : "Rotates the cookie. Reusing an old cookie ends the whole session.",
        "operationId" : "refresh",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccessTokenResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Swap the refresh token cookie for a new access token",
        "tags" : [ "sessions" ]
      }
    },
    "/api/v1/sign-ups" : {
      "post" : {
        "description" : "Emails a verification link. Answers the same whether or not the email has an account.",
        "operationId" : "signUp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SignUpResponse"
                }
              }
            },
            "description" : "Accepted"
          }
        },
        "summary" : "Sign up with email and password",
        "tags" : [ "sign-up" ]
      }
    },
    "/api/v1/sign-ups/{signUpId}/verification-emails" : {
      "post" : {
        "description" : "Sent only while the sign-up waits for verification. Answers the same either way.",
        "operationId" : "sendNewLinkForSignUp",
        "parameters" : [ {
          "in" : "path",
          "name" : "signUpId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "summary" : "Send a new verification link for a sign-up",
        "tags" : [ "sign-up" ]
      }
    },
    "/api/v1/users/me" : {
      "get" : {
        "operationId" : "currentUser",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUserResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The signed-in User",
        "tags" : [ "sessions" ]
      }
    },
    "/api/v1/verification-emails" : {
      "post" : {
        "description" : "Sent only while the link's sign-up waits for verification. Answers the same either way.",
        "operationId" : "sendNewLinkInPlaceOf",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LinkTokenRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "summary" : "Send a new verification link in place of an old one",
        "tags" : [ "sign-up" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AccessTokenResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        },
        "required" : [ "accessToken", "expiresAt" ]
      },
      "CreateGroupRequest" : {
        "type" : "object",
        "properties" : {
          "budget" : {
            "type" : "number",
            "description" : "In euros, to the cent. Leave it out for a Group without a budget.",
            "minimum" : 0
          },
          "exchangeDate" : {
            "type" : "string",
            "format" : "date"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          }
        },
        "required" : [ "exchangeDate", "name" ]
      },
      "CurrentUserResponse" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          }
        },
        "required" : [ "displayName", "email" ]
      },
      "GroupResponse" : {
        "type" : "object",
        "properties" : {
          "admin" : {
            "type" : "boolean",
            "description" : "Whether the signed-in User is its Admin."
          },
          "budget" : {
            "type" : "number",
            "description" : "In euros; absent when the Group has no budget."
          },
          "exchangeDate" : {
            "type" : "string",
            "format" : "date"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "inviteCode" : {
            "type" : "string",
            "description" : "The code of the Group's Invite Link: the SPA builds the link from it."
          },
          "members" : {
            "type" : "array",
            "description" : "The Admin first.",
            "items" : {
              "$ref" : "#/components/schemas/MemberResponse"
            }
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "admin", "exchangeDate", "id", "inviteCode", "members", "name" ]
      },
      "GroupSummaryResponse" : {
        "type" : "object",
        "properties" : {
          "admin" : {
            "type" : "boolean",
            "description" : "Whether the signed-in User is its Admin."
          },
          "budget" : {
            "type" : "number",
            "description" : "In euros; absent when the Group has no budget."
          },
          "exchangeDate" : {
            "type" : "string",
            "format" : "date"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "memberCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "admin", "exchangeDate", "id", "memberCount", "name" ]
      },
      "Health" : {
        "type" : "object",
        "description" : "Overall API health as reported by Actuator. Only status is part of the contract.",
        "properties" : {
          "status" : {
            "type" : "string",
            "description" : "UP when the API and its database work."
          }
        },
        "required" : [ "status" ]
      },
      "JoinGroupRequest" : {
        "type" : "object",
        "properties" : {
          "inviteCode" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          }
        },
        "required" : [ "inviteCode" ]
      },
      "LinkTokenRequest" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "token" ]
      },
      "MemberResponse" : {
        "type" : "object",
        "properties" : {
          "admin" : {
            "type" : "boolean"
          },
          "displayName" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Identifies the Member in the Group, e.g. to remove them."
          },
          "you" : {
            "type" : "boolean",
            "description" : "Whether this is the signed-in User."
          }
        },
        "required" : [ "admin", "displayName", "id", "you" ]
      },
      "MembershipResponse" : {
        "type" : "object",
        "properties" : {
          "groupId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "groupId" ]
      },
      "SignInRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ]
      },
      "SignUpRequest" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0
          },
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0,
            "pattern" : "\\s*[^@\\s]+@[^@\\s]+\\.[^@\\s]+\\s*"
          },
          "password" : {
            "type" : "string",
            "maxLength" : 72,
            "minLength" : 8
          }
        },
        "required" : [ "displayName", "email", "password" ]
      },
      "SignUpResponse" : {
        "type" : "object",
        "properties" : {
          "signUpId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "signUpId" ]
      }
    }
  }
}
