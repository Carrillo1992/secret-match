{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "tags" : [ {
    "description" : "Monitor and interact",
    "externalDocs" : {
      "description" : "Spring Boot Actuator Web API Documentation",
      "url" : "https://docs.spring.io/spring-boot/docs/current/actuator-api/html/"
    },
    "name" : "Actuator"
  } ],
  "paths" : {
    "/actuator/health" : {
      "get" : {
        "operationId" : "health",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Health"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Actuator web endpoint 'health'",
        "tags" : [ "Actuator" ]
      }
    },
    "/api/v1/email-verifications" : {
      "post" : {
        "operationId" : "verifyEmail",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EmailVerificationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Verify an email with the token from its verification link",
        "tags" : [ "sign-up" ]
      }
    },
    "/api/v1/sign-ups" : {
      "post" : {
        "description" : "Emails a verification link. Answers the same whether or not the email has an account.",
        "operationId" : "signUp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "summary" : "Sign up with email and password",
        "tags" : [ "sign-up" ]
      }
    },
    "/api/v1/verification-emails" : {
      "post" : {
        "description" : "Sent only to a User who has not verified their email yet. Answers the same either way.",
        "operationId" : "sendVerificationEmail",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/VerificationEmailRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "summary" : "Send a new verification link",
        "tags" : [ "sign-up" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "EmailVerificationRequest" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "token" ]
      },
      "Health" : {
        "type" : "object",
        "description" : "Overall API health as reported by Actuator. Only status is part of the contract.",
        "properties" : {
          "status" : {
            "type" : "string",
            "description" : "UP when the API and its database work."
          }
        },
        "required" : [ "status" ]
      },
      "SignUpRequest" : {
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string",
            "maxLength" : 50,
            "minLength" : 0
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 72,
            "minLength" : 8
          }
        },
        "required" : [ "displayName", "email", "password" ]
      },
      "VerificationEmailRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      }
    }
  }
}
