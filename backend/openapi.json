            "description" : "OK"
          }
        },
        "summary" : "The Group's Draw as the signed-in Member sees it",
        "tags" : [ "draw" ]
      },
      "post" : {
        "description" : "Only the Admin can, once, with at least 4 Members. Every Member is emailed. The answer is the Draw as the Admin sees it: their own Receiver.",
        "operationId" : "runDraw",
        "parameters" : [ {
          "in" : "path",
          "name" : "groupId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
